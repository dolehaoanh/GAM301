  stickyNoteInfos:
  - title: "Sinh vi\xEAn \u0111\u1EA1n"
    position:
      serializedVersion: 2
      x: -2559
      y: -2652
      width: 254
      height: 101
    contents: "Periodic Burst s\u1EBD sinh ra c\xE1c particle \u0111\u1ED3ng th\u1EDDi,
      trong v\xED d\u1EE5 n\xE0y ch\xFAng ta cho random t\u1EEB 3 \u0111\u1EBFn 5
      particle \u0111\u1ED3ng th\u1EDDi sau m\u1ED7i 2s"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Capacity
    position:
      serializedVersion: 2
      x: -2566
      y: -2347
      width: 254
      height: 100
    contents: "Ch\xFAng ta thi\u1EBFt l\u1EADp t\u1ED1i \u0111a s\u1ED1 particle
      \u0111\u1ED3ng th\u1EDDi trong 1 l\u1EA7n b\u1EAFn l\xE0 5"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: "Thi\u1EBFt l\u1EADp v\u1ECB tr\xED"
    position:
      serializedVersion: 2
      x: -2570
      y: -2236
      width: 254
      height: 102
    contents: "Shape: t\u1EA1o ra 1 h\xECnh c\u1EA7u\nPosition Mode: ch\u1EBF \u0111\u1ED9
      v\u1ECB tr\xED l\xE0 tr\xEAn b\u1EC1 m\u1EB7t h\xECnh c\u1EA7u\nSpawn Mode:
      Random v\u1ECB tr\xED c\xE1c h\u1EA1t n\u1EB1m tr\xEAn b\u1EC1 m\u1EB7t h\xECnh
      c\u1EA7u l\xE0 ng\u1EABu nhi\xEAn"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: "Th\u1EDDi gian t\u1ED3n t\u1EA1i"
    position:
      serializedVersion: 2
      x: -2570
      y: -2113
      width: 254
      height: 100
    contents: "Ch\xFAng ta ch\u1ECDn th\u1EDDi gian t\u1ED3n t\u1EA1i c\u1EE7a h\u1EA1t
      theo ch\u1EBF \u0111\u1ED9 Random Uniform (ng\u1EABu nhi\xEAn \u0111\u1ED3ng
      \u0111\u1EC1u) v\xE0 gi\xE1 tr\u1ECB min = 0,5 ; max = 1,5"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: "Thi\u1EBFt l\u1EADp t\u1ED1c \u0111\u1ED9"
    position:
      serializedVersion: 2
      x: -2571
      y: -2007
      width: 254
      height: 102
    contents: "Thi\u1EBFt l\u1EADp t\u1ED1c \u0111\u1ED9 ng\u1EABu nhi\xEAn cho m\u1ED7i
      particle\nNh\u01B0 trong v\xED d\u1EE5 n\xE0y, \u0111\u1EC3 c\xE1c h\u1EA1t
      b\u1EAFn v\u1EC1 c\xE1c ph\xEDa ng\u1EABu nhi\xEAn h\u01B0\u1EDBng l\xEAn tr\xEAn"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: "Thi\u1EBFt l\u1EADp m\xE0u s\u1EAFc"
    position:
      serializedVersion: 2
      x: -2571
      y: -1897
      width: 254
      height: 102
    contents: "Ch\xFAng ta thi\u1EBFt l\u1EADp 1 m\xE0u s\u1EAFc m\xE0 ch\xFAng ta
      mu\u1ED1n. K\xE9o Intensity \u0111\u1EC3 t\u0103ng c\u01B0\u1EDDng \u0111\u1ED9
      l\xE0m cho particle ph\xE1t s\xE1ng"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: "Thi\u1EBFt l\u1EADp k\xEDch c\u1EE1"
    position:
      serializedVersion: 2
      x: -2571
      y: -1782
      width: 254
      height: 102
    contents: "Thi\u1EBFt l\u1EADp k\xEDch th\u01B0\u1EDBc c\u1ED1 \u0111\u1ECBnh
      cho m\u1ED7i h\u1EA1t l\xE0 0.02"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: "Thi\u1EBFt l\u1EADp l\u1EF1c h\xFAt"
    position:
      serializedVersion: 2
      x: -2559
      y: -1645
      width: 254
      height: 102
    contents: "Ch\xFAng ta thi\u1EBFt l\u1EADp 1 l\u1EF1c h\xFAt = -7 \u0111\u1EC3
      c\xE1c h\u1EA1t khi b\u1EAFn l\xEAn s\u1EBD r\u01A1i nh\u1EB9 xu\u1ED1ng"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Trigger Event On Die
    position:
      serializedVersion: 2
      x: -2559
      y: -1533
      width: 254
      height: 102
    contents: "Ch\u1EBF \u0111\u1ED9 On Die l\xE0 khi particle h\u1EBFt th\u1EDDi
      gian (life time \u0111\xE3 set \u1EDF tr\xEAn) th\xEC k\xEDch ho\u1EA1t trigger
      n\xE0y.\nTrigger n\xE0y s\u1EBD t\u1EA1o ra 100 particle b\u1EB1ng GPU khi
      n\xF3 \u0111\u01B0\u1EE3c k\xEDch ho\u1EA1t"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Capacity
    position:
      serializedVersion: 2
      x: -1702
      y: -1078
      width: 292
      height: 102
    contents: "Thi\u1EBFt l\u1EADp s\u1ED1 h\u1EA1t t\u1ED1i \u0111a l\xE0 10000.
      C\xE1c h\u1EA1t \u0111\u01B0\u1EE3c sinh ra sau khi \u0111\u1EA1t \u0111\u1EBFn
      dung l\u01B0\u1EE3ng gi\u1EDBi h\u1EA1n s\u1EBD b\u1ECB lo\u1EA1i b\u1ECF"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Lifetime & Position
    position:
      serializedVersion: 2
      x: -1700
      y: -968
      width: 285
      height: 102
    contents: "Lifetime: Thi\u1EBFt l\u1EADp th\u1EDDi gian t\u1ED3n t\u1EA1i c\u1EE7a
      particle l\xE0 1.5s\nSet Posision From Source: thi\u1EBFt l\u1EADp v\u1ECB
      tr\xED theo ngu\u1ED3n (trong v\xED d\u1EE5 n\xE0y l\xE0 particle vi\xEAn \u0111\u1EA1n
      \u0111\u01B0\u1EE3c b\u1EAFn l\xEAn"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Add Position Shape
    position:
      serializedVersion: 2
      x: -1700
      y: -852
      width: 282
      height: 107
    contents: "T\u1EEB v\u1ECB tr\xED \u0111\u01B0\u1EE3c set \u1EDF tr\xEAn ch\xFAng
      ta c\u1ED9ng v\u1EDBi v\u1ECB tr\xED \u0111\u01B0\u1EE3c x\u1EBFp tr\xEAn b\u1EC1
      m\u1EB7t c\u1EE7a h\xECnh c\u1EA7u"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Velocity from Direction & Speed
    position:
      serializedVersion: 2
      x: -1696
      y: -712
      width: 286
      height: 204
    contents: "Block n\xE0y cho ph\xE9p ch\xFAng ta thi\u1EBFt l\u1EADp h\u01B0\u1EDBng
      bay v\xE0 t\u1ED1c \u0111\u1ED9 bay c\u1EE7a particle.\nTrong v\xED d\u1EE5
      n\xE0y, ch\xFAng ta cho h\u01B0\u1EDBng bay c\u1EE7a m\u1ED7i particle l\xE0
      bay theo tr\u1EE5c Z v\u1EDBi t\u1ED1c \u0111\u1ED9 b\u1EB1ng 3"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Linear Drag
    position:
      serializedVersion: 2
      x: -1695
      y: -76
      width: 287
      height: 105
    contents: "Thi\u1EBFt l\u1EADp 1 l\u1EF1c c\u1EA3n l\xE0m gi\u1EA3m t\u1ED1c
      \u0111\u1ED9 c\u1EE7a particle"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Set color
    position:
      serializedVersion: 2
      x: -1698
      y: 53
      width: 287
      height: 106
    contents: "Thi\u1EBFt l\u1EADp m\xE0u theo alpha trong th\u1EDDi gian s\u1ED1ng
      c\u1EE7a particle \u0111\u1EC3 particle m\u1EDD d\u1EA7n"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Output
    position:
      serializedVersion: 2
      x: -1706
      y: 295
      width: 287
      height: 105
    contents: "ch\u1ECDn texture h\xECnh ng\xF4i sao cho particle"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Orient
    position:
      serializedVersion: 2
      x: -1706
      y: 415
      width: 287
      height: 105
    contents: "Lu\xF4n h\u01B0\u1EDBng m\u1EB7t c\u1EE7a particle v\u1EC1 ph\xEDa
      camera"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Multiply Size
    position:
      serializedVersion: 2
      x: -1708
      y: 528
      width: 286
      height: 105
    contents: "Thi\u1EBFt l\u1EADp k\xEDch th\u01B0\u1EDBc ng\u1EABu nhi\xEAn cho
      particle"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: "Kh\u1EDFi t\u1EA1o particle strip (d\u1EA3i)"
    position:
      serializedVersion: 2
      x: -784
      y: 186
      width: 286
      height: 105
    contents: "\u0110\u1EC3 t\u1EA1o ra c\xE1c d\u1EA3i \xE1nh s\xE1ng k\xE9o d\xE0i
      th\xE0nh v\u1EC7t (\u0111u\xF4i c\u1EE7a c\xE1c particle tr\u01B0\u1EDBc \u0111\xF3).
      Ch\xFAng ta s\u1EED d\u1EE5ng Context Strip"
    theme: 
    textSize: Small
    colorTheme: 1
  - title: Position
    position:
      serializedVersion: 2
      x: -787
      y: 327
      width: 286
      height: 105
    contents: "Ch\xFAng ta thi\u1EBFt l\u1EADp v\u1ECB tr\xED c\u1EE7a \u0111\u1ED1i
      t\u01B0\u1EE3ng b\u1EB1ng c\xE1ch l\u1EA5y v\u1ECB tr\xED c\u1EE7a particle
      ngu\u1ED3n (cha) v\xE0 set v\xE0o v\u1ECB tr\xED c\u1EE7a strip"
    theme: 
    textSize: Small
    colorTheme: 1
  categories: []
  uiBounds:
    serializedVersion: 2
